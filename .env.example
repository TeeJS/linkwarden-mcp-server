# Linkwarden MCP Server Configuration
# Copy this file to .env and fill in your actual values

# --- Linkwarden -------------------------------------------------------------

# Linkwarden instance URL (without trailing slash)
LINKWARDEN_BASE_URL=https://your-linkwarden-instance.com

# Linkwarden API token (Settings -> Access Tokens)
LINKWARDEN_TOKEN=your-api-token-here

# Comma-separated toolsets to enable: search, collection, link, tags.
# Leave empty to enable all of them.
TOOLSETS=

# Set to true to disable every write tool (create/delete/archive)
READ_ONLY=false

# --- HTTP transport ---------------------------------------------------------
# Only used by the `http` subcommand. The stdio subcommand ignores these.

# Host port to publish. The container always listens on 8080 internally.
MCP_PORT=8080

# Path the MCP endpoint is served on
MCP_PATH=/mcp

# --- OAuth 2.1 --------------------------------------------------------------
# Off by default. Turn this on before exposing the endpoint to the internet:
# without it, anyone who can reach the URL gets full use of the Linkwarden
# token above, including the write tools.

MCP_OAUTH_ENABLED=false

# OIDC provider URL. This must match the issuer your provider reports in its
# discovery document *exactly*, trailing slash included, or discovery fails.
# Authentik example: https://auth.example.com/application/o/linkwarden-mcp/
MCP_OAUTH_ISSUER=

# Public base URL this server is reached on, no path.
# The connector URL is this plus MCP_PATH.
MCP_SERVER_URL=

# Expected "aud" claim. Leave empty to skip the audience check.
MCP_OAUTH_AUDIENCE=

# Seconds to cache provider discovery before re-fetching
MCP_OAUTH_JWKS_CACHE_TTL=3600

# --- Group-based tool access ------------------------------------------------
# Both empty = no group checking; any valid token gets whatever READ_ONLY and
# TOOLSETS already allow. Setting either one turns group checking on, and a
# user in none of the listed groups is refused with 403.
#
# Group policy only ever narrows access. It cannot grant write when the server
# is running with READ_ONLY=true.

# Token claim holding the caller's groups
MCP_GROUPS_CLAIM=groups

# Groups granted read tools only
MCP_READ_GROUPS=

# Groups granted every tool, including create/delete/archive
MCP_WRITE_GROUPS=
